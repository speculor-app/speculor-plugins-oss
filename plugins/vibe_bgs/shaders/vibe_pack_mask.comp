#version 450

// pack wide mask (uint32 per pixel) to GRAY8 (4 pixels per uint32)
// dispatched after vibe_process_wide to produce GPU-resident GRAY8 output

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    int num_channels;   // unused
    int bg_samples;     // unused
    int threshold;      // unused
    int required_bg_samples; // unused
    int learning_rate_and;   // unused
    int bg_samples_and;      // unused
    uint frame_number;       // unused
    int bytes_per_channel;   // unused
} pc;

// binding 2: wide mask input (uint32 per pixel, only low byte used)
layout(std430, set = 0, binding = 2) readonly buffer WideMask {
    uint data[];
} wide_mask;

// binding 4: packed mask output (4 pixels per uint32)
layout(std430, set = 0, binding = 4) writeonly buffer PackedMask {
    uint data[];
} packed_mask;

void main()
{
    // each thread packs 4 pixels into one uint32
    uint word_idx = gl_GlobalInvocationID.x;
    uint base_pixel = word_idx * 4;
    uint total_pixels = uint(pc.width * pc.height);
    if (base_pixel >= total_pixels) return;

    uint out_word = 0;
    for (uint i = 0; i < 4; ++i) {
        uint pixel = base_pixel + i;
        if (pixel >= total_pixels) break;
        uint val = wide_mask.data[pixel] & 0xFFu;
        out_word |= val << (i * 8);
    }

    packed_mask.data[word_idx] = out_word;
}
